From 2ae419f981b7ec69cb9b78df48fdf3ee3b6fb5a3 Mon Sep 17 00:00:00 2001
From: ReQo <justreqo@gmail.com>
Date: Tue, 24 Nov 2026 12:44:50 -0800
Subject: [PATCH] samsung: audio, fingerprint and ril bringup fixes

Change-Id: Ie512954337b04d1f05ce6913a3c1b2b67a01cc40
---
 audio/Android.mk                                                | 2 ++
 audio/audience.c                                                | 2 ++
 audio/audio_hw.c                                                | 2 ++
 hidl/fingerprint/Android.mk                                     | 1 +
 hidl/fingerprint/BiometricsFingerprint.cpp                      | 2 +-
 ...droid.hardware.biometrics.fingerprint@2.1-service.samsung.rc | 1 +
 ril/libsecril-client/Android.mk                                 | 1 +
 7 files changed, 10 insertions(+), 1 deletion(-)

diff --git a/audio/Android.mk b/audio/Android.mk
index 495a951..813278d 100644
--- a/audio/Android.mk
+++ b/audio/Android.mk
@@ -60,6 +60,8 @@ LOCAL_MODULE_RELATIVE_PATH := hw
 
 LOCAL_MODULE_TAGS := optional
 
+LOCAL_VENDOR_MODULE := true
+
 include $(BUILD_SHARED_LIBRARY)
 
 endif
diff --git a/audio/audience.c b/audio/audience.c
index 61ed5d0..207fa35 100644
--- a/audio/audience.c
+++ b/audio/audience.c
@@ -26,6 +26,8 @@
 
 #include "audience.h"
 
+#include <unistd.h>
+
 /*
  * Writes an Integer to a file.
  *
diff --git a/audio/audio_hw.c b/audio/audio_hw.c
index 712d3f8..46f47bf 100644
--- a/audio/audio_hw.c
+++ b/audio/audio_hw.c
@@ -35,6 +35,8 @@
 #include <math.h>
 #include <dlfcn.h>
 
+#include <unistd.h>
+
 #include <cutils/log.h>
 #include <cutils/str_parms.h>
 #include <cutils/atomic.h>
diff --git a/hidl/fingerprint/Android.mk b/hidl/fingerprint/Android.mk
index 91a0f3c..e5c5d31 100644
--- a/hidl/fingerprint/Android.mk
+++ b/hidl/fingerprint/Android.mk
@@ -49,6 +49,7 @@ LOCAL_MODULE_TAGS := optional
 LOCAL_MODULE_OWNER := samsung
 LOCAL_VENDOR_MODULE := true
 
+LOCAL_MULTILIB := 32
 include $(BUILD_EXECUTABLE)
 
 include $(call all-makefiles-under,$(LOCAL_PATH))
diff --git a/hidl/fingerprint/BiometricsFingerprint.cpp b/hidl/fingerprint/BiometricsFingerprint.cpp
index b38575d..cb1bf4c 100644
--- a/hidl/fingerprint/BiometricsFingerprint.cpp
+++ b/hidl/fingerprint/BiometricsFingerprint.cpp
@@ -41,7 +41,7 @@ BiometricsFingerprint* BiometricsFingerprint::sInstance = nullptr;
 BiometricsFingerprint::BiometricsFingerprint() : mClientCallback(nullptr) {
     sInstance = this;  // keep track of the most recent instance
     if (!openHal()) {
-        LOG(ERROR) << "Can't open HAL module";
+        LOG(ERROR) << "Can't open HAL module: " << dlerror();
     }
 }
 
diff --git a/hidl/fingerprint/android.hardware.biometrics.fingerprint@2.1-service.samsung.rc b/hidl/fingerprint/android.hardware.biometrics.fingerprint@2.1-service.samsung.rc
index dbc3043..2a21c16 100644
--- a/hidl/fingerprint/android.hardware.biometrics.fingerprint@2.1-service.samsung.rc
+++ b/hidl/fingerprint/android.hardware.biometrics.fingerprint@2.1-service.samsung.rc
@@ -1,4 +1,5 @@
 service vendor.fps_hal /vendor/bin/hw/android.hardware.biometrics.fingerprint@2.1-service.samsung
+    interface android.hardware.biometrics.fingerprint@2.1::IBiometricsFingerprint default
     # "class hal" causes a race condition on some devices due to files created
     # in /data. As a workaround, postpone startup until later in boot once
     # /data is mounted.
diff --git a/ril/libsecril-client/Android.mk b/ril/libsecril-client/Android.mk
index 3aa68f4..7268fb1 100755
--- a/ril/libsecril-client/Android.mk
+++ b/ril/libsecril-client/Android.mk
@@ -28,5 +28,6 @@ endif
 
 LOCAL_MODULE:= libsecril-client
 LOCAL_PRELINK_MODULE := false
+LOCAL_VENDOR_MODULE := true
 
 include $(BUILD_SHARED_LIBRARY)
-- 
2.25.1

